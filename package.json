{
  "name": "clearwatergroup.com",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && npm run build:static",
    "build:static": "cp index.html dist/ && for dir in books contact faq sea-level-rise services team; do cp -r $dir dist/; done",
    "preview": "wrangler pages dev dist",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply clearwater-db --local",
    "deploy": "npm run build && wrangler pages deploy dist"
  },
  "dependencies": {
    "drizzle-orm": "^0.39.0",
    "hono": "^4.7.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^7.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250124.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "drizzle-kit": "^0.30.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.1.0",
    "wrangler": "^3.105.0"
  }
}
